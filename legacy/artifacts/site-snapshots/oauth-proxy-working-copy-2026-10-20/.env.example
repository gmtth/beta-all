OAUTH_SCOPE=movidesk:read
OAUTH_GPT_ACTION_CLIENT_ID=movidesk-gpt-action
OAUTH_MCP_CLIENT_ID=movidesk-mcp-app
# Comma-separated exact official GPT Action callback URLs.
OAUTH_GPT_ACTION_REDIRECT_URIS=https://chat.openai.com/aip/<action-id>/oauth/callback
# Optional. If set, GPT Action token requests must include this client_secret.
OAUTH_GPT_ACTION_CLIENT_SECRET=
# Comma-separated exact MCP callback URLs. Leave empty to allow official ChatGPT connector callbacks and local loopback callbacks.
OAUTH_MCP_REDIRECT_URIS=
